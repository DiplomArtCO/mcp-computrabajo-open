{
  "name": "mcp-computrabajo-open",
  "description": "A Model Context Protocol (MCP) server for accessing Computrabajo job listings in Latin America",
  "version": "1.0.1",
  "module": "dist/src/index.js",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "type": "module",
  "bin": {
    "mcp-computrabajo-open": "dist/src/index.js"
  },
  "private": false,
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "server",
    "computrabajo",
    "peru",
    "jobs",
    "employment",
    "api",
    "typescript",
    "bun",
    "sdk",
    "cheerio",
    "html",
    "scraping",
    "claude"
  ],
  "author": "Sergio Torres",
  "license": "MIT",
  "files": [
    "dist/src/*.js",
    "dist/src/*.d.ts",
    "ONBOARDING.md",
    "scripts/install-skills.mjs",
    "skills/*.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build --target=node ./src/index.ts --outdir=dist/src --external playwright --external keytar && bun run build:declaration",
    "build:declaration": "tsc --emitDeclarationOnly --project tsconfig.types.json",
    "format": "bunx biome check --write",
    "prepare": "husky",
    "postinstall": "node scripts/install-skills.mjs",
    "prepublishOnly": "bun run build",
    "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts",
    "typecheck": "bun run cf-typegen && tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "inspect:worker": "bunx @modelcontextprotocol/inspector",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.4.1",
    "@types/node": "^22.20.2",
    "husky": "9.1.7",
    "typescript": "5.8.3",
    "wrangler": "^4.130.0"
  },
  "peerDependencies": {
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "cheerio": "1.2.0",
    "keytar": "^7.9.0",
    "playwright": "^1.63.0",
    "zod": "4.4.3"
  }
}
