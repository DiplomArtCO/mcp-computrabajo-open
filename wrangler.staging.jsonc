{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computrabajo-open-mcp-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "2f4fcbd8df0249728bf1c6cec0050687",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
