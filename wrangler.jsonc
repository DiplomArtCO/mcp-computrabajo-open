{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computrabajo-open-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "f7f9c28ab6bd1d61cb9718aab89f35d1",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
